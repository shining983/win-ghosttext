<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WinGhostText.Core</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Authors>shining983</Authors>
    <PackageLicenseExpression>PolyForm-Noncommercial-1.0.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/shining983/win-ghosttext</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\english-freq.txt" LogicalName="WinGhostText.Core.Data.english-freq.txt" />
    <EmbeddedResource Include="Data\english-extra.txt" LogicalName="WinGhostText.Core.Data.english-extra.txt" />
    <EmbeddedResource Include="Data\common-misspellings.txt" LogicalName="WinGhostText.Core.Data.common-misspellings.txt" />
    <EmbeddedResource Include="Data\proper-nouns.txt" LogicalName="WinGhostText.Core.Data.proper-nouns.txt" />
  </ItemGroup>
</Project>
